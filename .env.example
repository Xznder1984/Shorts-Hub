# === YouTube Data API v3 ===
# Get one at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# === TikTok (optional, scraping-based) ===
# Leave blank to disable TikTok integration
# Some scrapers may need session cookies for higher rate limits
TIKTOK_SESSION_COOKIE=

# === Instagram (optional, scraping-based) ===
# Leave blank to disable Instagram integration
# Instaloader may need login for some features
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# === App Settings ===
# Backend port (default: 8000)
BACKEND_PORT=8000

# Cache TTL in seconds (default: 3 hours = 10800)
CACHE_TTL=10800

# Rate limit: max requests per minute per platform
RATE_LIMIT_PER_MINUTE=20

# Demo mode: enable static placeholder videos. The auto-feed also falls
# back to demo content automatically when all configured sources return
# nothing (e.g. before API keys are set). Default false.
DEMO_MODE=false
